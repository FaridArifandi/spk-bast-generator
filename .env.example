APP_NAME="SPK-BAST Generator"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# ── Database ────────────────────────────────────────────────
# MySQL/MariaDB, baik lokal (Laragon) maupun hosting (cPanel).
# Buat dulu database kosong bernama sesuai DB_DATABASE (utf8mb4_unicode_ci).
# Laragon bawaan: user root, password kosong. Di cPanel isi user & password database.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=spk_bast_generator
DB_USERNAME=root
DB_PASSWORD=

# Tanpa Redis/queue worker: semua memakai file / sinkron sehingga cocok untuk shared hosting.
SESSION_DRIVER=file
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Isi true bila situs sudah memakai HTTPS
SESSION_SECURE_COOKIE=false

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# URL web app Apps Script (berakhiran /exec) untuk `php artisan spk:sync-sheets`.
# Sama dengan APPS_SCRIPT_URL di public/js/config.js sistem lama.
SHEETS_URL=
# Token rahasia ekspor DB -> Google Sheets (isi bebas, panjang, sama dengan TOKEN di Apps Script)
SHEETS_TOKEN=
