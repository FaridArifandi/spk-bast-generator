# Contoh .env untuk HOSTING (cPanel). Buat berkas bernama .env di folder aplikasi (sejajar artisan),
# lalu isi nilai bertanda GANTI. Jangan unggah .env dari komputer lokal.

APP_NAME="SPK-BAST Generator"
APP_ENV=production
# Isi dengan menjalankan: php artisan key:generate   (jangan dibagikan ke siapa pun)
APP_KEY=
# WAJIB false di hosting, kalau true halaman galat membocorkan isi .env
APP_DEBUG=false
APP_URL=https://dokumen.it-1175.my.id
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=error

# Database MySQL dari cPanel (MySQL Databases). Di cPanel hostnya hampir selalu localhost.
# Nama database & user otomatis berawalan nama akun cPanel. Pakai huruf/angka/underscore saja.
# Password dengan simbol (# $ spasi dsb.) tulis di dalam tanda kutip ganda.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=GANTI_nama_database
DB_USERNAME=GANTI_user_database
DB_PASSWORD="GANTI_password_database"

SESSION_DRIVER=file
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Situs memakai HTTPS
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Opsional: tarik data master dari Google Sheets (php artisan spk:sync-sheets)
SHEETS_URL=
